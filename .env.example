# Copy to .env and fill in your own values.
# NEVER commit .env or an API key to GitHub.

SNOWFLAKE_ACCOUNT=YOUR_ACCOUNT_IDENTIFIER
SNOWFLAKE_USER=YOUR_USERNAME
SNOWFLAKE_PASSWORD=YOUR_PASSWORD
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=TALENTPULSE
SNOWFLAKE_SCHEMA=JOB_ANALYTICS
SNOWFLAKE_ROLE=ACCOUNTADMIN

# Needed only when using the planned AI classification stage.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

OPENAI_MODEL=gpt-4.1-mini-2025-04-14

AI_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MIN_INTERVAL=7

# Product-first PostgreSQL foundation. Server-only; never commit real values.
# Keep existing Snowflake/Gemini values in your local .env unchanged.
APP_ENV=development
DATABASE_URL=postgresql://YOUR_USER:YOUR_URL_ENCODED_PASSWORD@YOUR_HOST:5432/postgres?sslmode=require
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
APP_BASE_URL=http://localhost:3000
ALLOW_DEVELOPMENT_JOBS=false
DATABASE_CA_CERT=product/certs/prod-ca-2021.crt
# Generated by: python -m product.provision_access --apply
# Restricted logins, never the owner connection, serve the API and ingestion worker.
# INGEST_DATABASE_URL=postgresql://YOUR_WORKER_USER:YOUR_PASSWORD@YOUR_HOST:5432/postgres?sslmode=require
# Future restricted web connection, not the owner/migration credential:
# APP_DATABASE_URL=postgresql://YOUR_WEB_USER:YOUR_PASSWORD@YOUR_HOST:5432/postgres?sslmode=require
# Phase 5: automatically provisioned dedicated account role; never expose to React.
# MEMBER_DATABASE_URL=postgresql://YOUR_MEMBER_USER:YOUR_PASSWORD@YOUR_HOST:5432/postgres?sslmode=require
# Public launch: APP_ENV=production and APP_BASE_URL=https://your-domain
# Configure Supabase Auth redirect URLs and custom SMTP in its dashboard.
